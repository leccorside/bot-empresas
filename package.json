{"name":"local-prospector","private":true,"version":"1.0.0","workspaces":["apps/*","packages/*"],"scripts":{"build":"npm run db:generate && npm run build -w @prospector/api && npm run build -w @prospector/web && npm run build -w @prospector/worker && npm run build -w @prospector/scheduler","dev:api":"npm run dev -w @prospector/api","dev:web":"npm run dev -w @prospector/web","db:generate":"prisma generate --schema packages/database/prisma/schema.prisma","db:migrate":"prisma migrate deploy --schema packages/database/prisma/schema.prisma","db:seed":"tsx packages/database/prisma/seed.ts","lint":"tsc --noEmit -p tsconfig.check.json","test":"vitest run","test:watch":"vitest"},"dependencies":{"@nestjs/common":"^11.1.6","@nestjs/core":"^11.1.6","@nestjs/platform-express":"^11.1.6","@nestjs/swagger":"^11.2.0","@prisma/client":"^6.14.0","@tanstack/react-query":"^5.85.5","bcryptjs":"^3.0.2","bullmq":"^5.58.5","class-transformer":"^0.5.1","class-validator":"^0.14.2","compression":"^1.8.1","cron-parser":"^5.3.1","date-fns":"^4.1.0","exceljs":"^4.4.0","express-rate-limit":"^8.0.1","helmet":"^8.1.0","ioredis":"^5.7.0","jsonwebtoken":"^9.0.2","libphonenumber-js":"^1.12.13","next":"^16.3.2","pino":"^9.9.0","pino-pretty":"^13.1.1","react":"^19.1.1","react-dom":"^19.1.1","reflect-metadata":"^0.2.2","rxjs":"^7.8.2","zod":"^4.1.5"},"devDependencies":{"@nestjs/cli":"^11.0.10","@types/bcryptjs":"^2.4.6","@types/jsonwebtoken":"^9.0.10","@types/node":"^22.17.2","@types/react":"^19.1.10","@types/react-dom":"^19.1.7","prisma":"^6.14.0","tsx":"^4.20.4","typescript":"^5.9.2","vitest":"^3.2.4"}}
